# 支付宝 App 支付（轻羽云 Android）：证书模式；应用私钥仅服务端持有，勿提交仓库。
# 异步通知 URL 固定为 ${PUBLIC_BASE_URL}/api/v1/webhooks/alipay/notify（须在开放平台应用网关或产品里配置一致）。
# ALIPAY_PRODUCTION：未设置时默认为 true（正式环境）；设为 false 时使用沙箱网关（须与沙箱应用一致）。
# ALIPAY_APP_PRIVATE_KEY 与 ALIPAY_APP_PRIVATE_KEY_PATH 二选一；多行 PEM 可写入 env 文件。
# ALIPAY_APP_CERT_PUBLIC_PATH：应用公钥证书（如 appCertPublicKey_*.crt）
# ALIPAY_PLATFORM_CERT_PUBLIC_PATH：支付宝公钥证书（如 alipayCertPublicKey_RSA2.crt）
# ALIPAY_ROOT_CERT_PATH：支付宝根证书（alipayRootCert.crt）
ALIPAY_APP_ID=2021006155603350
ALIPAY_APP_PRIVATE_KEY_PATH=/home/ubuntu/qingyu-secure/alipay/app_private_rsa.txt
ALIPAY_APP_CERT_PUBLIC_PATH=/home/ubuntu/qingyu-secure/alipay/appCertPublicKey_2021006155603350.crt
ALIPAY_PLATFORM_CERT_PUBLIC_PATH=/home/ubuntu/qingyu-secure/alipay/alipayCertPublicKey_RSA2.crt
ALIPAY_ROOT_CERT_PATH=/home/ubuntu/qingyu-secure/alipay/alipayRootCert.crt
ALIPAY_PRODUCTION=true

ALIPAY_PC_APP_ID=2021006153681663
ALIPAY_PC_APP_PRIVATE_KEY_PATH=/home/ubuntu/qingyu-secure/alipay/app_private_rsa.txt
ALIPAY_PC_APP_CERT_PUBLIC_PATH=/home/ubuntu/qingyu-secure/alipay-pc/appCertPublicKey_2021006153681663.crt
ALIPAY_PC_PLATFORM_CERT_PUBLIC_PATH=/home/ubuntu/qingyu-secure/alipay-pc/alipayCertPublicKey_RSA2.crt
ALIPAY_PC_ROOT_CERT_PATH=/home/ubuntu/qingyu-secure/alipay-pc/alipayRootCert.crt


# ---------------------------------------------------------------------------
# 阿里云号码认证 — 短信验证码（Dypnsapi 2017-05-25）
# 用于：POST /api/v1/me/password/sms/send（SendSmsVerifyCode）
#      PATCH /api/v1/me/profile 带 sms_verify_code（CheckSmsVerifyCode，以 Model.VerifyResult=PASS 为准）
# RAM 须授权：dypns:SendSmsVerifyCode、dypns:CheckSmsVerifyCode
# 控制台：赠送签名与赠送模板须配对；TemplateParam 使用 {"code":"##code##",...} 时由 API 发码并可核验
# ALIYUN_SMS_SCHEME_NAME：若发送时非空，核验（Check）须传相同方案名
# ---------------------------------------------------------------------------
ALIYUN_ACCESS_KEY_ID=your-access-key-id
ALIYUN_ACCESS_KEY_SECRET=your-access-key-secret
ALIYUN_SMS_REGION=cn-hangzhou
# 赠送签名名称（与号码认证/短信认证控制台「赠送签名」一致）
ALIYUN_SMS_SIGN_NAME=恒创联众
# 赠送模板 CODE（与赠送签名搭配）
ALIYUN_SMS_TEMPLATE_CODE=100001
# 可选；默认方案可留空。非空时须与发送接口 SchemeName 一致
ALIYUN_SMS_SCHEME_NAME=
# 与模板变量一致，JSON 字符串；默认与动态验证码占位符示例
ALIYUN_SMS_TEMPLATE_PARAM={"code":"##code##","min":"5"}



ADMIN_USERNAME=kymjs
ADMIN_PASSWORD=ZTkymjs123!?

